{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["phaser"],
    "rootDir": ".",
    "outDir": ".build",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "inlineSources": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", ".build", "dist"]
}
